  "private": true,
  "type": "module",
  "description": "A retro-style incremental game inspired by the Commodore computer",
  "author": "David Heger <david_heger@hotmail.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/D-Heger/CommodoreClickerClone"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
